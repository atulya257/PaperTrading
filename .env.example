# Optional settings for the React app.
# Copy this file to .env.local (ignored by Git) and uncomment a line to use it.
# By default the app uses ports 8081 and 8082 on the computer that served the page.

# VITE_STOCK_SERVICE_URL=http://localhost:8081
# VITE_USER_SERVICE_URL=http://localhost:8082

# The User Service's MySQL login is not set here. Set MYSQL_USER and MYSQL_PASSWORD in the
# terminal that starts the service (see docs/SETUP.md). Never commit real passwords.
